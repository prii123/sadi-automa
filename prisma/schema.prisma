model resoluciones {
  id                  Int       @id @default(autoincrement())
  empresa_id          Int
  activo              Int?      @default(1)
  fecha_inicio        DateTime? @db.Date
  fecha_final         DateTime? @db.Date
  notificacion        String?
  renovado            Int?      @default(0)
  facturado           Int?      @default(0)
  comentarios         String?
