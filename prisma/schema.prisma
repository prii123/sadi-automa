  fecha_actualizacion DateTime? @default(now()) @db.Timestamp(6)
  empresas            empresas  @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([activo], map: "idx_resoluciones_activo")
  @@index([empresa_id], map: "idx_resoluciones_empresa_id")
  @@index([fecha_final], map: "idx_resoluciones_fecha_final")
}

model role_modulos {
  id                  Int       @id @default(autoincrement())
  role_id             Int
  modulo_id           Int
  permisos            String
  activo              Int?      @default(1)
  fecha_creacion      DateTime? @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime? @default(now()) @db.Timestamp(6)
  modulos             modulos   @relation(fields: [modulo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles               roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([role_id, modulo_id])
  @@index([modulo_id], map: "idx_role_modulos_modulo_id")
  @@index([role_id], map: "idx_role_modulos_role_id")
}

model roles {
  id                  Int            @id @default(autoincrement())
  nombre              String         @unique
  descripcion         String?
  activo              Int?           @default(1)
  fecha_creacion      DateTime?      @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime?      @default(now()) @db.Timestamp(6)
  role_modulos        role_modulos[]
  usuarios            usuarios[]

  @@index([activo], map: "idx_roles_activo")
}

model ticket_estados {
  id                  Int       @id @default(autoincrement())
  nombre              String    @unique @db.VarChar(50)
  descripcion         String?
  activo              Int?      @default(1)
  fecha_creacion      DateTime? @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime? @default(now()) @db.Timestamp(6)
  tickets             tickets[]
}

model ticket_messages {
  id             Int       @id @default(autoincrement())
  ticket_id      Int
  user_id        Int
  message        String
  fecha_creacion DateTime? @default(now()) @db.Timestamp(6)
  tickets        tickets   @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios       usuarios  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ticket_id], map: "idx_ticket_messages_ticket_id")
  @@index([user_id], map: "idx_ticket_messages_user_id")
}

model ticket_modulos {
  id                  Int       @id @default(autoincrement())
  nombre              String    @unique @db.VarChar(100)
  descripcion         String?
  activo              Int?      @default(1)
  fecha_creacion      DateTime? @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime? @default(now()) @db.Timestamp(6)
  tickets             tickets[]
}

model ticket_prioridades {
  id                  Int       @id @default(autoincrement())
  nombre              String    @unique @db.VarChar(50)
  descripcion         String?
  activo              Int?      @default(1)
  fecha_creacion      DateTime? @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime? @default(now()) @db.Timestamp(6)
  tickets             tickets[]
}

model ticket_tipos_solicitud {
  id                  Int       @id @default(autoincrement())
  nombre              String    @unique @db.VarChar(100)
  descripcion         String?
  activo              Int?      @default(1)
  fecha_creacion      DateTime? @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime? @default(now()) @db.Timestamp(6)
  tickets             tickets[]
}

model tickets {
  id                                    Int                     @id @default(autoincrement())
  user_id                               Int
  empresa_id                            Int
  modulo_id                             Int?
  tipo_solicitud_id                     Int?
  prioridad_id                          Int?
  estado_id                             Int?
  asignado_a                            Int?
  descripcion                           String
  fecha_creacion                        DateTime?               @default(now()) @db.Timestamp(6)
  fecha_actualizacion                   DateTime?               @default(now()) @db.Timestamp(6)
  ticket_messages                       ticket_messages[]
  usuarios_tickets_asignado_aTousuarios usuarios?               @relation("tickets_asignado_aTousuarios", fields: [asignado_a], references: [id], onDelete: NoAction, onUpdate: NoAction)
  empresas                              empresas                @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ticket_estados                        ticket_estados?         @relation(fields: [estado_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket_modulos                        ticket_modulos?         @relation(fields: [modulo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket_prioridades                    ticket_prioridades?     @relation(fields: [prioridad_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket_tipos_solicitud                ticket_tipos_solicitud? @relation(fields: [tipo_solicitud_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios_tickets_user_idTousuarios    usuarios                @relation("tickets_user_idTousuarios", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([asignado_a], map: "idx_tickets_asignado_a")
  @@index([empresa_id], map: "idx_tickets_empresa_id")
  @@index([estado_id], map: "idx_tickets_estado_id")
  @@index([user_id], map: "idx_tickets_user_id")
}

model trigger_ejecuciones {
  id                      Int       @id @default(autoincrement())
  trigger_id              Int
  trigger_nombre          String?
  fecha_ejecucion         DateTime? @db.Timestamp(6)
  estado                  String?   @default("exitoso")
  notificaciones_enviadas Int?      @default(0)
  empresas_procesadas     Int?      @default(0)
  error_mensaje           String?
  detalles                String?
  triggers                triggers  @relation(fields: [trigger_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model triggers {
  id                  Int                   @id @default(autoincrement())
  nombre              String
  descripcion         String?
  frecuencia          String?               @default("diaria")
  hora                String?               @default("08:00")
  dias_semana         String?
  dia_mes             Int?
  intervalo_horas     Int?
  destinatarios       String?
  prioridades         String?               @default("CRITICA,ALTA,MEDIA")
  activo              Int?                  @default(1)
  ultima_ejecucion    DateTime?             @db.Timestamp(6)
  proxima_ejecucion   DateTime?             @db.Timestamp(6)
  creado_en           DateTime?             @default(now()) @db.Timestamp(6)
  actualizado_en      DateTime?             @default(now()) @db.Timestamp(6)
  trigger_ejecuciones trigger_ejecuciones[]

  @@index([activo], map: "idx_triggers_activo")
  @@index([proxima_ejecucion], map: "idx_triggers_proxima_ejecucion")
}

model usuario_empresas {
  id                  Int       @id @default(autoincrement())
  usuario_id          Int
  empresa_id          Int
  rol_en_empresa      String?   @default("usuario") @db.VarChar(50)
  activo              Int?      @default(1)
  fecha_creacion      DateTime? @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime? @default(now()) @db.Timestamp(6)
  empresas            empresas  @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios            usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([usuario_id, empresa_id])
}

model usuarios {
  id                                   Int                    @id @default(autoincrement())
  username                             String                 @unique
  password_hash                        String
  nombre                               String
  email                                String
  rol                                  String?                @default("usuario")
  activo                               Int?                   @default(1)
  fecha_creacion                       DateTime?              @default(now()) @db.Timestamp(6)
