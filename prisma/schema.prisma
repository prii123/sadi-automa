model empresa_contacto {
  id               Int       @id @default(autoincrement())
  empresa_id       Int       @unique
  telefono         String?   @db.VarChar(20)
  email            String?   @db.VarChar(255)
  direccion        String?
  persona_contacto String?   @db.VarChar(255)
  activo           Boolean?  @default(true)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  empresas         empresas  @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([activo], map: "idx_empresa_contacto_activo")
  @@index([empresa_id], map: "idx_empresa_contacto_empresa_id")
}

model empresa_impuestos {
  id               Int        @id @default(autoincrement())
  empresa_id       Int?
  impuesto_id      Int?
  activo           Boolean?   @default(true)
  fecha_asignacion DateTime?  @default(now()) @db.Timestamp(6)
  created_at       DateTime?  @default(now()) @db.Timestamp(6)
  updated_at       DateTime?  @default(now()) @db.Timestamp(6)
  empresas         empresas?  @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  impuestos        impuestos? @relation(fields: [impuesto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([empresa_id, impuesto_id])
  @@index([activo], map: "idx_empresa_impuestos_activo")
  @@index([empresa_id], map: "idx_empresa_impuestos_empresa")
  @@index([empresa_id], map: "idx_empresa_impuestos_empresa_id")
  @@index([impuesto_id], map: "idx_empresa_impuestos_impuesto")
  @@index([impuesto_id], map: "idx_empresa_impuestos_impuesto_id")
}

model empresas {
  id                    Int                     @id @default(autoincrement())
  nit                   String                  @unique
  nombre                String
  tipo                  String
  estado                String                  @default("activo")
  fecha_creacion        DateTime                @db.Timestamp(6)
  fecha_actualizacion   DateTime                @db.Timestamp(6)
  contador_id           Int?
  calendario_tributario calendario_tributario[]
  certificados          certificados[]
  documentos            documentos[]
  empresa_contacto      empresa_contacto?
  empresa_impuestos     empresa_impuestos[]
  usuarios              usuarios?               @relation(fields: [contador_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  eventos_tributarios   eventos_tributarios[]
  notificaciones        notificaciones[]
  resoluciones          resoluciones[]
  tickets               tickets[]
  usuario_empresas      usuario_empresas[]
  vigencias_exogena     vigencias_exogena[]

  @@index([contador_id], map: "idx_contador_id")
  @@index([contador_id], map: "idx_empresas_contador_id")
  @@index([estado], map: "idx_empresas_estado")
  @@index([nit], map: "idx_empresas_nit")
  @@index([estado], map: "idx_estado")
  @@index([nit], map: "idx_nit")
}

model event_attendees {
  id              Int       @id @default(autoincrement())
  event_id        String    @db.VarChar(255)
  attendee_email  String    @db.VarChar(255)
  response_status String?   @default("needsAction") @db.VarChar(50)
  last_updated    DateTime? @default(now()) @db.Timestamp(6)
  created_at      DateTime? @default(now()) @db.Timestamp(6)

  @@unique([event_id, attendee_email])
  @@index([attendee_email], map: "idx_event_attendees_email")
  @@index([event_id], map: "idx_event_attendees_event_id")
  @@index([response_status], map: "idx_event_attendees_status")
}

model eventos_tributarios {
  id                  Int      @id @default(autoincrement())
  titulo              String
  descripcion         String?
  tipo                String
  fecha_vencimiento   DateTime @db.Timestamp(6)
  empresa_id          Int
