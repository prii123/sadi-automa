  fecha_actualizacion DateTime @default(now()) @db.Timestamp(6)
  empresas            empresas @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([empresa_id], map: "idx_eventos_tributarios_empresa_id")
  @@index([estado], map: "idx_eventos_tributarios_estado")
  @@index([fecha_vencimiento], map: "idx_eventos_tributarios_fecha_vencimiento")
