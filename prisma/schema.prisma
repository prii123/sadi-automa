// Nuevos modelos para Información Exógena

model vigencias_exogena {
  id             Int      @id @default(autoincrement())
  empresa_id     Int
  anio_fiscal    Int
  estado         String   @default("activo") @db.VarChar(20)
  fecha_creacion DateTime @default(now()) @db.Timestamp(6)
  empresas       empresas @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Relaciones
  plan_cuentas                plan_cuentas[]
  asociaciones_cuenta_formato asociaciones_cuenta_formato[]

  @@unique([empresa_id, anio_fiscal])
  @@index([empresa_id], map: "idx_vigencias_exogena_empresa_id")
  @@index([anio_fiscal], map: "idx_vigencias_exogena_anio_fiscal")
}

model formatos_exogena {
  id          Int     @id @default(autoincrement())
  anio_fiscal Int
  codigo      String  @db.VarChar(10)
  nombre      String  @db.VarChar(255)
  descripcion String?
  obligatorio Boolean @default(false)
  activo      Boolean @default(true)

  // Relaciones
  conceptos_exogena            conceptos_exogena[]
  campos_requeridos_formatos   campos_requeridos_formatos[]
  asociaciones_cuenta_formato  asociaciones_cuenta_formato[]

  @@unique([anio_fiscal, codigo])
  @@index([anio_fiscal], map: "idx_formatos_exogena_anio_fiscal")
}

model campos_requeridos_formatos {
  id           Int     @id @default(autoincrement())
  formato_id   Int
  atributo     String  @db.VarChar(100)
  denominacion String? @db.VarChar(255)
  tipo         String? @db.VarChar(50)
  longitud     Int?
  criterios    String?
  formatos_exogena formatos_exogena @relation(fields: [formato_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([formato_id, atributo])
  @@index([formato_id], map: "idx_campos_requeridos_formato_id")
}

model conceptos_exogena {
  id          Int     @id @default(autoincrement())
  anio_fiscal Int
  formato_id  Int
  codigo      String  @db.VarChar(20)
  nombre      String  @db.VarChar(255)
  descripcion String?
  formatos_exogena formatos_exogena @relation(fields: [formato_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Relaciones
  asociaciones_cuenta_formato asociaciones_cuenta_formato[]

  @@unique([anio_fiscal, formato_id, codigo])
  @@index([anio_fiscal], map: "idx_conceptos_exogena_anio_fiscal")
  @@index([formato_id], map: "idx_conceptos_exogena_formato_id")
}

model plan_cuentas {
  id          Int      @id @default(autoincrement())
  vigencia_id Int
  codigo      String   @db.VarChar(20)
  nombre      String   @db.VarChar(255)
  tipo        String?  @db.VarChar(50)
  nivel       Int      @default(1)
  padre_id    Int?
  activo      Boolean  @default(true)
  vigencias_exogena vigencias_exogena @relation(fields: [vigencia_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  padre             plan_cuentas?     @relation("plan_cuentas_hierarchy", fields: [padre_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hijos             plan_cuentas[]    @relation("plan_cuentas_hierarchy")

  // Relaciones
  cuentas_auxiliares           cuentas_auxiliares[]
  asociaciones_cuenta_formato  asociaciones_cuenta_formato[]

  @@unique([vigencia_id, codigo])
  @@index([vigencia_id], map: "idx_plan_cuentas_vigencia_id")
  @@index([padre_id], map: "idx_plan_cuentas_padre_id")
}

model cuentas_auxiliares {
  id             Int      @id @default(autoincrement())
  plan_cuenta_id Int
  codigo         String   @db.VarChar(20)
  nombre         String   @db.VarChar(255)
  tercero_id     Int?
  saldo_anterior Decimal? @default(0) @db.Decimal(15, 2)
  debito         Decimal? @default(0) @db.Decimal(15, 2)
  credito        Decimal? @default(0) @db.Decimal(15, 2)
  saldo_final    Decimal? @default(0) @db.Decimal(15, 2)
  activo         Boolean  @default(true)
  plan_cuentas   plan_cuentas  @relation(fields: [plan_cuenta_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  terceros       terceros?     @relation(fields: [tercero_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([plan_cuenta_id, codigo, tercero_id])
  @@index([plan_cuenta_id], map: "idx_cuentas_auxiliares_plan_cuenta_id")
  @@index([tercero_id], map: "idx_cuentas_auxiliares_tercero_id")
}

model asociaciones_cuenta_formato {
  id          Int     @id @default(autoincrement())
  vigencia_id Int
  cuenta_id   Int
  formato_id  Int
  concepto_id Int?
  categoria   String? @db.VarChar(100)
  campo_valor String? @db.VarChar(20)
  activo      Boolean @default(true)
  vigencias_exogena vigencias_exogena @relation(fields: [vigencia_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  plan_cuentas       plan_cuentas       @relation(fields: [cuenta_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  formatos_exogena   formatos_exogena   @relation(fields: [formato_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conceptos_exogena  conceptos_exogena? @relation(fields: [concepto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vigencia_id, cuenta_id, formato_id])
  @@index([vigencia_id], map: "idx_asociaciones_vigencia_id")
  @@index([cuenta_id], map: "idx_asociaciones_cuenta_id")
  @@index([formato_id], map: "idx_asociaciones_formato_id")
}

model terceros {
  id               Int      @id @default(autoincrement())
  tipo_tercero     String   @db.VarChar(10) // 'NIT' o 'CC'
  nit_cc           String   @unique @db.VarChar(20)
  razon_social     String?  @db.VarChar(255) // Solo para NIT
  nombre1          String   @db.VarChar(100) // Obligatorio
  nombre2          String?  @db.VarChar(100)
  apellido1        String?  @db.VarChar(100) // Obligatorio para CC
  apellido2        String?  @db.VarChar(100)
  direccion        String?  @db.VarChar(255)
  codigo_municipio String?  @db.VarChar(10)
  codigo_pais      String   @default("CO") @db.VarChar(10)
  activo           Boolean  @default(true)

  // Relaciones
  cuentas_auxiliares cuentas_auxiliares[]

  @@index([tipo_tercero], map: "idx_terceros_tipo_tercero")
}

model import_jobs {
  id                Int       @id @default(autoincrement())
  tipo              String    @db.VarChar(50) // 'plan_cuentas', 'cuentas_auxiliares', etc.
  vigencia_id       Int
  usuario_id        Int?
  estado            String    @default("pending") @db.VarChar(20) // 'pending', 'processing', 'completed', 'failed'
  progreso          Int       @default(0) // 0-100
  total_filas       Int       @default(0)
  filas_procesadas  Int       @default(0)
  filas_exitosas    Int       @default(0)
  filas_fallidas    Int       @default(0)
  mensaje           String?   @db.Text
  errores           Json?
  advertencias      Json?
  resultado         Json?
  archivo_nombre    String?   @db.VarChar(255)
  fecha_inicio      DateTime? @default(now()) @db.Timestamp(6)
  fecha_fin         DateTime? @db.Timestamp(6)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @default(now()) @db.Timestamp(6)

  @@index([vigencia_id], map: "idx_import_jobs_vigencia")
  @@index([estado], map: "idx_import_jobs_estado")
  @@index([tipo], map: "idx_import_jobs_tipo")
  @@index([fecha_inicio(sort: Desc)], map: "idx_import_jobs_fecha")
}
