generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model calendario_tributario {
  id                      Int                     @id @default(autoincrement())
  empresa_id              Int?
  impuesto_id             Int?
  fecha_vencimiento       DateTime                @db.Timestamp(6)
  periodo                 String?                 @db.VarChar(20)
  estado                  String?                 @default("pendiente") @db.VarChar(20)
  fecha_pago              DateTime?               @db.Date
  monto_pagado            Decimal?                @db.Decimal(15, 2)
  observaciones           String?
  created_at              DateTime?               @default(now()) @db.Timestamp(6)
  updated_at              DateTime?               @default(now()) @db.Timestamp(6)
  vencimiento_impuesto_id Int?
  google_event_id         String?                 @db.VarChar(255)
  synced_to_google        Boolean?                @default(false)
  google_last_sync        DateTime?               @db.Timestamp(6)
  empresas                empresas?               @relation(fields: [empresa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  impuestos               impuestos?              @relation(fields: [impuesto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vencimientos_impuestos  vencimientos_impuestos? @relation(fields: [vencimiento_impuesto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([empresa_id, vencimiento_impuesto_id, periodo], map: "calendario_tributario_empresa_id_vencimiento_impuesto_id_period")
  @@index([empresa_id, fecha_vencimiento], map: "idx_calendario_empresa_fecha")
  @@index([empresa_id], map: "idx_calendario_empresa_id")
  @@index([estado], map: "idx_calendario_estado")
  @@index([fecha_vencimiento], map: "idx_calendario_fecha_vencimiento")
  @@index([google_event_id], map: "idx_calendario_google_event_id")
  @@index([synced_to_google], map: "idx_calendario_synced_to_google")
  @@index([vencimiento_impuesto_id], map: "idx_calendario_vencimiento_impuesto_id")
}

model certificados {
  id                  Int       @id @default(autoincrement())
  empresa_id          Int
  activo              Int?      @default(1)
  fecha_inicio        DateTime? @db.Date
  fecha_final         DateTime? @db.Date
  notificacion        String?
  renovado            Int?      @default(0)
  facturado           Int?      @default(0)
  comentarios         String?
  fecha_creacion      DateTime? @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime? @default(now()) @db.Timestamp(6)
  empresas            empresas  @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([activo], map: "idx_certificados_activo")
  @@index([empresa_id], map: "idx_certificados_empresa_id")
  @@index([fecha_final], map: "idx_certificados_fecha_final")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model document_attachments {
  id                  Int       @id @default(autoincrement())
  document_type       String    @db.VarChar(50)
  document_id         Int
  filename            String    @db.VarChar(255)
  original_filename   String    @db.VarChar(255)
  file_path           String
  file_size           Int?
  mime_type           String?   @db.VarChar(100)
  uploaded_by         Int?
  fecha_creacion      DateTime? @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime? @default(now()) @db.Timestamp(6)
  usuarios            usuarios? @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([document_type, document_id, filename])
  @@index([document_type, document_id], map: "idx_document_attachments_type_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model document_template_attachments {
  id            Int         @id @default(autoincrement())
  template_id   Int?
  document_type String      @db.VarChar(50)
  file_name     String      @db.VarChar(255)
  original_name String      @db.VarChar(255)
  file_size     Int
  mime_type     String      @default("application/pdf") @db.VarChar(100)
  description   String?
  active        Boolean?    @default(true)
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?   @default(now()) @db.Timestamptz(6)
  plantillas    plantillas? @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([active], map: "idx_document_template_attachments_active")
  @@index([template_id], map: "idx_document_template_attachments_template_id")
  @@index([document_type], map: "idx_document_template_attachments_type")
}

model documentos {
